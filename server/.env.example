# KannadaSaathi Backend Environment Variables for Render Deployment
# PORT is assigned automatically by Render in production
PORT=5000
NODE_ENV=production

# Optional: Google Gemini API Key for Live AI Multimodal Vision, Chat, and Translation
# Obtain key at: https://aistudio.google.com/app/apikey
# Note: Variable name MUST be GEMINI_API_KEY (not GOOGLE_API_KEY)
# If provided, enables Gemini 1.5 Flash multimodal vision and live chat.
# If omitted, backend runs safely in Demo Mode with built-in neural translation and dictionary.
GEMINI_API_KEY=your_gemini_api_key_here
